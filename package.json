{
  "name": "comtap",
  "private": true,
  "description": "Repository scripts for ComTap: the file size check and the release tooling. The app's version lives only in Cargo.toml.",
  "type": "module",
  "scripts": {
    "check:structure": "node scripts/check-file-lines.mjs",
    "release:windows": "cargo build --release --locked",
    "release:linux": "cargo build --release --locked --target x86_64-unknown-linux-musl",
    "release:package": "node scripts/package-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/release-notes-template.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:promote": "node scripts/promote-release.mjs"
  }
}
